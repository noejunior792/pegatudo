{
  "manifest_version": 3,
  "name": "PegaTudo - Ultimate Video Downloader",
  "version": "3.0.0",
  "description": "Ultimate video download engine with 50+ modular JavaScript components. Download from any site with advanced streaming protocol support, encryption handling, and intelligent detection.",
  "permissions": [
    "downloads",
    "activeTab",
    "storage",
    "scripting",
    "unlimitedStorage",
    "tabs",
    "debugger",
    "declarativeNetRequest",
    "webRequest",
    "background",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/js/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/js/core/types.js",
        "src/js/core/logger.js",
        "src/js/core/config.js",
        "src/js/core/events.js",
        "src/js/crypto/crypto-engine.js",
        "src/js/crypto/key-manager.js",
        "src/js/network/network-manager.js",
        "src/js/streaming/streaming-engine.js",
        "src/js/parsers/hls-parser.js",
        "src/js/parsers/dash-parser.js",
        "src/js/extractors/youtube-extractor.js",
        "src/js/utils.js",
        "src/js/interceptor.js",
        "src/js/content.js",
        "src/js/advanced-integration.js"
      ],
      "css": [
        "src/css/popup.css", 
        "src/css/features/toast.css",
        "src/css/advanced/download-manager.css",
        "src/css/advanced/filters.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon128.png",
        "src/js/core/*.js",
        "src/js/crypto/*.js",
        "src/js/extractors/*.js",
        "src/js/network/*.js",
        "src/js/streaming/*.js",
        "src/js/parsers/*.js",
        "src/js/ui/*.js",
        "src/js/utils/*.js",
        "src/js/formats/*.js",
        "src/js/protocols/*.js",
        "src/js/detection/*.js",
        "src/js/schedulers/*.js",
        "src/js/filters/*.js",
        "src/js/export/*.js",
        "src/js/services/*.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "src/html/settings.html",
  "declarative_net_request": {
    "rule_resources": []
  }
}
